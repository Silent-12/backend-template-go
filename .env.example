# 复制为 .env 使用；优先级：系统环境变量 > .env > 默认值

# 运行环境：development / test / production
APP_ENV=development
# 服务名
APP_NAME=backend-template-go
# HTTP 监听地址
HOST=0.0.0.0
# HTTP 监听端口
PORT=3000
# 全局 API 前缀，留空则不设置
API_PREFIX=backend
# 跨域来源，逗号分隔；留空时开发放行、生产不授权
CORS_ORIGINS=
# 可信代理 CIDR，逗号分隔；留空则不信任代理头；禁止 0.0.0.0/0、::/0 等零前缀网段
TRUSTED_PROXY_CIDRS=
# 数据库访问日志，依赖 MySQL
HTTP_LOG_ENABLED=false
# 接口文档，生产环境强制关闭
DOCS_ENABLED=true
# 文档 Basic 认证开关
DOCS_AUTH_ENABLED=false
# 文档认证用户名，启用认证时必填
DOCS_USERNAME=
# 文档认证密码，启用认证时必填
DOCS_PASSWORD=
# 示例模块出站请求的可信来源：仅 http/https origin，不含路径、查询、片段或通配符
# 留空时示例上游探测返回 501；派生服务应改为自己上游的地址，禁止接收调用方传入完整 URL
# EXAMPLE_UPSTREAM_ORIGIN=

# MySQL 开关，启用前先执行迁移
MYSQL_ENABLED=false
# MySQL 地址
DB_HOST=127.0.0.1
# MySQL 端口
DB_PORT=3306
# MySQL 用户名
DB_USERNAME=app
# MySQL 密码
DB_PASSWORD=
# 数据库名：启用 MySQL 时必须填写，派生服务使用各自独立的库名，禁止沿用模板示例值
# DB_DATABASE=
# SQL 调试日志，可能包含参数
DB_LOGGING=false

# Redis 开关
REDIS_ENABLED=false
# Redis 地址
REDIS_HOST=127.0.0.1
# Redis 端口
REDIS_PORT=6379
# Redis ACL 用户名，可留空
REDIS_USERNAME=
# Redis 密码
REDIS_PASSWORD=
# Redis 数据库编号：0～15
REDIS_DB=0
# Redis 键前缀，默认继承 APP_NAME
# REDIS_KEY_PREFIX=my-service
# 限流开关，依赖 Redis
THROTTLE_ENABLED=false
# 限流键前缀，默认继承 REDIS_KEY_PREFIX
# THROTTLE_KEY_PREFIX=legacy-my-service
